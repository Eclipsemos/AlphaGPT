# Copy this file to .env and replace the placeholders.
BIRDEYE_API_KEY=replace-with-your-birdeye-key
DB_USER=alphagpt
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=crypto_quant

# Read-only Binance Spot research defaults. Public market data needs no API key.
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_ARCHIVE_BASE_URL=https://data.binance.vision/data/spot/monthly/klines
BINANCE_HISTORY_DAYS=365
BINANCE_MAX_SYMBOLS=50
BINANCE_MIN_LISTING_DAYS=30
BINANCE_MIN_QUOTE_VOLUME=10000000

# Optional: only needed for read-only wallet balance display.
# QUICKNODE_RPC_URL=https://api.mainnet-beta.solana.com

# Do not set this for research mode.
# SOLANA_PRIVATE_KEY=
